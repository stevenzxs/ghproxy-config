# BEGIN managed ghproxy.stevenzxs.cn
ghproxy.stevenzxs.cn {
    @frontend {
        method GET HEAD
        path / /assets/* /favicon.ico
    }
    handle @frontend {
        reverse_proxy ghproxy-backend:5000
    }
    @health path /ready
    handle @health {
        reverse_proxy ghproxy-backend:5000
    }
    @download {
        method GET HEAD
        path_regexp download ^/https:/+(github\.com/[^/]+/[^/]+/(releases|archive|blob|raw)/.+|raw\.githubusercontent\.com/[^/]+/[^/]+/.+)$
    }
    handle @download {
        reverse_proxy ghproxy-backend:5000 {
            header_up -Authorization
            header_up -Cookie
        }
    }
    @discover {
        method GET
        path_regexp discover ^/https:/+github\.com/[^/]+/[^/]+/info/refs$
        query service=git-upload-pack
    }
    handle @discover {
        reverse_proxy ghproxy-backend:5000 {
            header_up -Authorization
            header_up -Cookie
        }
    }
    @fetch {
        method POST
        path_regexp fetch ^/https:/+github\.com/[^/]+/[^/]+/git-upload-pack$
    }
    handle @fetch {
        request_body {
            max_size 10MB
        }
        reverse_proxy ghproxy-backend:5000 {
            header_up -Authorization
            header_up -Cookie
        }
    }
    handle {
        respond 403
    }
}
# END managed ghproxy.stevenzxs.cn
